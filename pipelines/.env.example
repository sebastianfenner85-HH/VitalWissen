# VitalWissen — Umgebungsvariablen
# Kopiere diese Datei als .env und fülle die Werte aus

# Supabase (Datenbank)
SUPABASE_URL=https://DEIN_PROJEKT.supabase.co
SUPABASE_ANON_KEY=DEIN_ANON_KEY
SUPABASE_DB_URL=postgresql://postgres:DEIN_PASSWORT@db.DEIN_PROJEKT.supabase.co:5432/postgres

# Anthropic (für LLM-Extraktion in Phase 2)
ANTHROPIC_API_KEY=sk-ant-...

# PubMed (optional, erhöht Rate Limit)
PUBMED_API_KEY=

# Umgebung
ENVIRONMENT=development  # development | production
